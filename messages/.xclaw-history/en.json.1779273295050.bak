  "helpDesk": {
    "headline": "Deploy an agent that doesn't just respond to customers — it resolves their issues, updates your CRM, and escalates only when necessary.",
    "subtext": "Syrix Help Desk is an AI-first customer service and sales automation platform that operates as a digital employee — available 24/7.",
    "cta": "Book Demo",
    "capabilities": {
      "rag": "RAG-powered knowledge retrieval from your product docs",
      "crm": "Autonomous CRM lead creation and record updates",
      "email": "Automated email workflows (follow-up, confirmation, escalation)",
      "escalation": "Intelligent human escalation by sentiment, complexity, and risk",
      "multiChannel": "Multi-channel deployment (web widget, email, Zalo)"
    },
    "journey": "Website Visit → AI Consultation → Identity Verification → Lead Qualified → CRM Logged → Sales Notified",
    "integration": "300+ app integrations via MCP (Model Context Protocol)",
    "faq": {
      "q1": "How long does deployment take?",
      "a1": "Typically 3-6 weeks for the first solution, depending on data readiness and integration complexity.",
      "q2": "What systems do you integrate with?",
      "a2": "Syrix connects to any system with an API — CRM, ERP, HRM, email, knowledge bases, and 300+ apps via the Model Context Protocol.",
      "q3": "Is my customer data secure?",
      "a3": "Yes. Syrix operates in a private environment with VPC deployment, SSO integration, and comprehensive audit trails.",
      "q4": "When does a human step in?",
      "a4": "You configure escalation rules based on sentiment analysis, topic complexity, customer tier, and risk level.",
      "q5": "What happens if the AI doesn't know the answer?",
      "a5": "Syrix is built on a strict RAG policy — it only answers from verified company documents."
    },
    "trust": "Every agent decision is logged with a full audit trail. High-risk actions require human approval gates."
  },
  "aiAgent": {
    "headline": "Your company's private brain. Accurate, secure, always on.",
