    "security": {
      "vpc": "VPC Deployment — Runs in your virtual private cloud, fully isolated",
      "sso": "SSO Integration — Works with your existing identity provider",
      "audit": "Audit Trails — Every query and response is logged for compliance",
      "encryption": "Encryption at rest and in transit — AES-256 + TLS 1.3"
    },
    "faq": {
      "q1": "What document formats are supported?",
      "a1": "PDF, DOCX, TXT, Markdown, Notion export, Confluence, SharePoint.",
      "q2": "How often is the knowledge base updated?",
      "a2": "You can trigger updates manually or set up automatic sync on a schedule.",
      "q3": "Can I control which documents the AI accesses?",
      "a3": "Yes. You organize documents into collections and assign them to agents.",
      "q4": "How accurate are the answers?",
      "a4": "Syrix AI only generates answers based on retrieved document passages. Every answer includes citations."
    }
