  "hero": {
    "headline": "Your AI shouldn't just answer questions. It should complete the work.",
    "subheadline": "Syrix connects large language models directly to your CRM, ERP, HRM, email, and knowledge bases — so your AI agents can read, write, and act across every system through simple natural language commands.",
    "cta": "Book Demo"
  },
  "problem": {
    "headline": "Your enterprise has AI. Your people are still doing the manual work.",
    "body": "Most enterprises have adopted generative AI for Q&A and content creation. But there's a fundamental gap between an AI that can answer questions and an AI that can execute business processes.",
    "before": "BEFORE",
    "after": "AFTER",
    "beforeDescription": "Sales rep gets qualified lead at 11pm\n→ AI answers product question ✓\n→ But someone still manually: creates CRM record, notifies account manager\n→ 4 manual steps. 1 human who could have been sleeping.",
    "afterDescription": "Same lead at 11pm with Syrix\n→ AI qualifies lead, creates CRM record, notifies team\n→ Zero human intervention. Closed-loop automation."
  },
  "howItWorks": {
    "headline": "How Syrix Works",
    "step1": { "title": "Connect", "description": "Syrix connects to your existing systems — CRM, ERP, HRM, email, internal knowledge bases — in days, not months. No rip-and-replace." },
    "step2": { "title": "Instruct", "description": "Your team communicates in natural language. No complex configuration. No training required." },
    "step3": { "title": "Execute", "description": "Syrix executes across applications autonomously — creating records, updating systems, sending notifications, completing workflows — all without manual intervention." }
  },
